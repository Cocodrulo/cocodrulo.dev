---
function getLocaleFromUrl(url: URL) {
    throw new Error("Function not implemented.");
}

import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import "@/styles/global.css";

interface Props {
    title?: string;
}

const pageURL = Astro.request.url;
const { title } = Astro.props;

const language = Astro.currentLocale || "es";
---

<!doctype html>
<html lang={language}>
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="Javier Aday Pérez Romero" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/images/Logo.svg" />

        <meta
            property="og:title"
            content={title ? `${title} - Cocodrulo` : "Cocodrulo"}
        />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={pageURL ?? "https://cocodrulo.dev/"} />
        <meta
            property="og:image"
            content={"https://cocodrulo.dev/images/Logo.png"}
        />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:locale" content="es_ES" />
        <meta property="og:locale:alternate" content="en_GB" />
        <meta
            property="og:description"
            content="Página web oficial de Cocodrulo donde encontrarás todo lo relacionado con este creador."
        />
        <SpeedInsights />
        <title>{title ? `${title} - Cocodrulo` : "Cocodrulo"}</title>
    </head>
    <body class="overflow-hidden">
        <Header />
        <main
            class="scroll-p-10 h-[90dvh] max-w-[100vw] overflow-hidden overflow-y-auto">
            <slot />
            <Footer />
        </main>
    </body>
</html>

<style is:global>
    html {
        scroll-behavior: smooth;
    }

    @media (prefers-animate: reduce) {
        html {
            scroll-behavior: auto;
        }
    }

    html,
    body {
        color-scheme: light dark;
        min-height: 100%;
        height: 100%;
        width: 100%;
        display: table;
        overflow: hidden;
        overflow-y: auto;
        font-family:
            "Trebuchet MS", "Lucida Sans Unicode", "Lucida Grande",
            "Lucida Sans", Arial, sans-serif;
    }

    main {
        scroll-behavior: smooth;
    }

    body {
        background: #100f0e;
    }

    code {
        font-family:
            Menlo,
            Monaco,
            Lucida Console,
            Liberation Mono,
            DejaVu Sans Mono,
            Bitstream Vera Sans Mono,
            Courier New,
            monospace;
    }

    ::-webkit-scrollbar {
        width: 2.5px;
        height: 2.5px;
    }

    ::-webkit-scrollbar-track {
        background: transparent;
    }

    ::-webkit-scrollbar-thumb {
        background: white;
        border-radius: 10px;
        transition: all 0.3s linear;
    }

    ::-webkit-scrollbar-thumb:hover,
    ::-webkit-scrollbar-thumb:active {
        background: #100f0e;
    }

    .scroll {
        animation: fade-up-animation linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 20%;
    }

    @keyframes fade-up-animation {
        from {
            opacity: 0;
            translate: 0 50px;
            scale: 0.7;
        }

        to {
            opacity: 1;
            translate: 0 0;
            scale: 1;
        }
    }
</style>
