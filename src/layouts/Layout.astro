---
import Header from '@components/Header.astro'
import Footer from '@components/Footer.astro'
import '@/styles/global.css'

interface Props {
    title?: string
    description?: string
    ogImage?: string | object
    canonicalURL?: string
    ogType?: string
    noindex?: boolean
}

const pageURL = Astro.request.url
const {
    title,
    description: customDescription,
    ogImage: customOgImage,
    canonicalURL,
    ogType = 'website',
    noindex = false,
} = Astro.props

const language = Astro.currentLocale || 'es'

// Localized fallback descriptions
const defaultDescription =
    language === 'es'
        ? 'Sitio web oficial de Javier Aday Pérez Romero (Cocodrulo) - Desarrollador de software y creador. Explora mis proyectos, artículos de blog y certificaciones.'
        : 'Official website of Javier Aday Pérez Romero (Cocodrulo) - Software developer and creator. Explore my projects, blog posts, and certifications.'

const description = customDescription || defaultDescription

// Resolve canonical URL
const canonical = canonicalURL || pageURL

// Helper to resolve dynamic or static image URLs to absolute URLs
const getPublicImageUrl = (imageObj: any) => {
    if (!imageObj) return 'https://cocodrulo.dev/images/Logo.png'
    if (typeof imageObj === 'string') {
        if (imageObj.startsWith('http')) return imageObj
        return `https://cocodrulo.dev${imageObj.startsWith('/') ? '' : '/'}${imageObj}`
    }

    if (imageObj.url) {
        if (imageObj.url.startsWith('http')) return imageObj.url
        return `https://cocodrulo.dev${imageObj.url.startsWith('/') ? '' : '/'}${imageObj.url}`
    }

    const storageKey = imageObj.meta?.storageKey
    if (storageKey) {
        if (Astro.locals.emdash?.getPublicMediaUrl) {
            const url = Astro.locals.emdash.getPublicMediaUrl(storageKey)
            if (url.startsWith('http')) return url
            return `https://cocodrulo.dev${url.startsWith('/') ? '' : '/'}${url}`
        }
        return `https://files.cocodrulo.dev/${storageKey}`
    }

    if (imageObj.id) {
        return `https://cocodrulo.dev/_emdash/api/media/file/${imageObj.id}`
    }

    return 'https://cocodrulo.dev/images/Logo.png'
}

const ogImage = getPublicImageUrl(customOgImage)

// Calculate alternate links for localization
const path = new URL(pageURL).pathname

const getAlternatePath = (currentPath: string, currentLang: string) => {
    if (currentLang === 'es') {
        // Alt is English, prefix with /en
        return `/en${currentPath === '/' ? '' : currentPath}`
    } else {
        // Alt is Spanish, remove leading /en
        const stripped = currentPath.replace(/^\/en/, '')
        return stripped === '' ? '/' : stripped
    }
}

const alternateEsPath = language === 'es' ? path : getAlternatePath(path, 'en')
const alternateEnPath = language === 'en' ? path : getAlternatePath(path, 'es')

const alternateEsUrl = `https://cocodrulo.dev${alternateEsPath}`
const alternateEnUrl = `https://cocodrulo.dev${alternateEnPath}`
---

<!doctype html>
<html lang={language}>
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/images/Logo.svg" />
        <link rel="canonical" href={canonical} />

        {noindex && <meta name="robots" content="noindex, follow" />}

        {/* Alternate hreflang versions for localized SEO */}
        <link rel="alternate" hreflang="es" href={alternateEsUrl} />
        <link rel="alternate" hreflang="en" href={alternateEnUrl} />
        <link rel="alternate" hreflang="x-default" href={alternateEsUrl} />

        {/* Open Graph / Facebook */}
        <meta
            property="og:title"
            content={title ? `${title} - Cocodrulo` : 'Cocodrulo'}
        />
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={pageURL} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:type" content="image/png" />
        <meta
            property="og:locale"
            content={language === 'es' ? 'es_ES' : 'en_US'}
        />
        <meta
            property="og:locale:alternate"
            content={language === 'es' ? 'en_GB' : 'es_ES'}
        />
        <meta property="og:description" content={description} />

        {/* Twitter */}
        <meta name="twitter:card" content="summary_large_image" />
        <meta
            name="twitter:title"
            content={title ? `${title} - Cocodrulo` : 'Cocodrulo'}
        />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        <title>{title ? `${title} - Cocodrulo` : 'Cocodrulo'}</title>
    </head>
    <body class="overflow-hidden overflow-y-auto">
        <Header />
        <main class="scroll-p-10 min-h-[54.5dvh] w-screen overflow-hidden">
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style is:global>
    html {
        scroll-behavior: smooth;
    }

    @media (prefers-animate: reduce) {
        html {
            scroll-behavior: auto;
        }
    }

    html,
    body {
        color-scheme: light dark;
        min-height: 100%;
        height: 100%;
        width: 100%;
        font-family:
            'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande',
            'Lucida Sans', Arial, sans-serif;
    }

    main {
        scroll-behavior: smooth;
    }

    body {
        background: #100f0e;
    }

    code {
        font-family:
            Menlo,
            Monaco,
            Lucida Console,
            Liberation Mono,
            DejaVu Sans Mono,
            Bitstream Vera Sans Mono,
            Courier New,
            monospace;
    }

    ::-webkit-scrollbar {
        width: 2.5px;
        height: 2.5px;
    }

    ::-webkit-scrollbar-track {
        background: transparent;
    }

    ::-webkit-scrollbar-thumb {
        background: white;
        border-radius: 10px;
        transition: all 0.3s linear;
    }

    ::-webkit-scrollbar-thumb:hover,
    ::-webkit-scrollbar-thumb:active {
        background: #100f0e;
    }

    .scroll {
        animation: fade-up-animation linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 20%;
    }

    @keyframes fade-up-animation {
        from {
            opacity: 0;
            translate: 0 50px;
            scale: 0.7;
        }

        to {
            opacity: 1;
            translate: 0 0;
            scale: 1;
        }
    }
</style>
