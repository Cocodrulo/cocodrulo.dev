---
import Title from '@/components/Title.astro'
import Layout from '@layouts/Layout.astro'

const isEnglish = Astro.currentLocale === "en" || Astro.url.pathname.startsWith('/en/') || Astro.url.pathname === '/en';

const title = isEnglish ? "404 - Page Not Found" : "404 - Página no encontrada";
const heading = isEnglish ? "Page Not Found" : "Página no encontrada";
const description = isEnglish 
    ? "Sorry, the page you are looking for does not exist, has been removed, or has changed its URL." 
    : "Lo sentimos, la página que estás buscando no existe, ha sido eliminada o su dirección ha cambiado.";
const homeHref = isEnglish ? "/en" : "/";
const homeText = isEnglish ? "Back to home" : "Volver al inicio";
---

<Layout title={title} noindex={true}>
    <div
        class="flex flex-col items-center justify-center min-h-[70dvh] px-6 text-center select-none">
        <div class="relative max-w-md p-10">
            <!-- Glow background effect -->
            <div
                class="absolute -top-12 -left-12 w-36 h-36 bg-blue-500/20 rounded-full blur-3xl">
            </div>
            <div
                class="absolute -bottom-12 -right-12 w-36 h-36 bg-purple-500/20 rounded-full blur-3xl">
            </div>

            <Title title="404" />
            <h2 class="mt-4 text-2xl font-bold text-white">
                {heading}
            </h2>
            <p class="mt-4 text-white/60 text-sm leading-relaxed">
                {description}
            </p>
            <div class="mt-8">
                <a
                    href={homeHref}
                    class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-white bg-white/10 border border-white/20 rounded-xl hover:bg-white hover:text-black transition-all duration-300 hover:scale-105 active:scale-95 hover:shadow-[0_0_15px_rgba(255,255,255,0.15)]">
                    {homeText}
                </a>
            </div>
        </div>
    </div>
</Layout>

