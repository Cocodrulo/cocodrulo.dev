---
import { getEmDashEntry } from 'emdash'
import Layout from '@layouts/Layout.astro'
import Title from '@/components/Title.astro'
import { Image, PortableText } from 'emdash/ui'

const { slug } = Astro.params
const language = Astro.currentLocale || 'es'

if (!slug) {
    return Astro.redirect('/404')
}

const { entry: projectEntry } = await getEmDashEntry('projects', slug, {
    locale: language,
})

if (!projectEntry) {
    return Astro.redirect('/404')
}

const project = projectEntry as unknown as {
    data: {
        title: string
        description: any
        url?: string
        start_date?: string
        end_date?: string
        labels: Array<{ etiqueta?: string; label?: string }>
        image: any
    }
}

const formatDate = (dateStr: string, locale: string) => {
    if (!dateStr) return ''
    const date = new Date(dateStr)
    const options: Intl.DateTimeFormatOptions = {
        month: 'short',
        year: 'numeric',
    }
    const formatted = date.toLocaleDateString(
        locale === 'es' ? 'es-ES' : 'en-US',
        options,
    )
    return formatted.charAt(0).toUpperCase() + formatted.slice(1)
}

const getExcerpt = (description: any) => {
    if (!Array.isArray(description)) return ''
    const firstBlock = description[0]
    if (!firstBlock || !Array.isArray(firstBlock.children)) return ''
    const text = firstBlock.children.map((child: any) => child.text).join('')
    return text.length > 150 ? text.slice(0, 150) + '...' : text
}
---

<Layout
    title={project.data.title}
    description={getExcerpt(project.data.description)}
    ogImage={project.data.image}>
    <div class="max-w-7xl mx-auto px-6 py-12">
        <div class="mb-8">
            <a
                href="/projects"
                class="group inline-flex items-center text-xs font-medium text-neutral-400 hover:text-white transition-colors gap-1.5">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke="currentColor"
                    class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform">
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"></path>
                </svg>
                Volver a proyectos
            </a>
        </div>

        <header class="mb-8 text-left max-w-3xl mx-auto">
            <div class="flex flex-col gap-2">
                <h1
                    class="text-3xl sm:text-4xl font-semibold tracking-tight text-white">
                    {project.data.title}
                </h1>
            </div>
        </header>

        <!-- Horizontal Metadata Row -->
        <div
            class="flex flex-wrap gap-x-10 gap-y-6 py-6 border-y border-neutral-900 max-w-3xl mx-auto mb-10 text-sm">
            {project.data.start_date && (
                <div>
                    <span
                        class="text-[10px] font-semibold uppercase tracking-widest text-neutral-500 block mb-1"
                        >Duración</span
                    >
                    <span class="text-neutral-300 font-medium">
                        {formatDate(project.data.start_date, language)} — {
                            project.data.end_date
                                ? formatDate(project.data.end_date, language)
                                : 'Presente'
                        }
                    </span>
                </div>
            )}
            {
                project.data.labels && project.data.labels.length > 0 && (
                    <div class="flex-1 min-w-[200px]">
                        <span class="text-[10px] font-semibold uppercase tracking-widest text-neutral-500 block mb-1">
                            Tecnologías
                        </span>
                        <div class="flex flex-wrap gap-1.5 mt-1">
                            {project.data.labels.map((tag: any) => (
                                <span class="text-xs text-neutral-400 bg-neutral-900 border border-neutral-800 px-2.5 py-0.5 rounded-md">
                                    {tag.etiqueta || tag.label}
                                </span>
                            ))}
                        </div>
                    </div>
                )
            }
            {
                project.data.url && (
                    <div class="flex items-end">
                        <a
                            href={project.data.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group inline-flex items-center text-xs font-semibold text-neutral-200 bg-neutral-950 border border-neutral-800 hover:bg-neutral-900 hover:text-white px-4 py-2 rounded-lg transition-all duration-200 gap-1.5">
                            Visitar sitio web
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="2"
                                stroke="currentColor"
                                class="w-3.5 h-3.5 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
                                />
                            </svg>
                        </a>
                    </div>
                )
            }
        </div>

        <div
            class="relative w-full aspect-video overflow-hidden bg-neutral-950 border border-neutral-900 rounded-xl mb-12 max-w-3xl mx-auto">
            {
                project.data.image && (
                    <Image
                        image={project.data.image}
                        width={1200}
                        height={675}
                        alt={project.data.title}
                        class="object-cover w-full h-full"
                    />
                )
            }
        </div>

        <div class="max-w-3xl mx-auto w-full mb-20">
            <div
                class="project-description text-neutral-300 leading-relaxed text-base flex flex-col gap-6 prose prose-neutral prose-invert max-w-none prose-p:my-1 prose-p:text-pretty prose-headings:my-1 prose-h1:mt-0 prose-h2:mt-0 prose-h3:mt-0 prose-h4:mt-0 prose-h5:mt-0 prose-h6:mt-0 prose-ul:my-1">
                <PortableText value={project.data.description} />
            </div>
        </div>
    </div>
</Layout>
