---
import { getEmDashEntry } from "emdash";
import Layout from "@layouts/Layout.astro";
import Title from "@/components/Title.astro";
import { Image, PortableText } from "emdash/ui";

const { slug } = Astro.params;
const language = Astro.currentLocale || "es";

if (!slug) {
    return Astro.redirect("/404");
}

const { entry: projectEntry } = await getEmDashEntry("projects", slug, {
    locale: language,
});

if (!projectEntry) {
    return Astro.redirect("/404");
}

const project = projectEntry as unknown as {
    data: {
        title: string;
        description: any;
        url?: string;
        start_date: string;
        end_date?: string;
        labels: Array<{ label: string }>;
        image: any;
    };
};

const formatDate = (dateStr: string, locale: string) => {
    if (!dateStr) return "";
    const date = new Date(dateStr);
    const options: Intl.DateTimeFormatOptions = { month: "short", year: "numeric" };
    const formatted = date.toLocaleDateString(locale === "es" ? "es-ES" : "en-US", options);
    return formatted.charAt(0).toUpperCase() + formatted.slice(1);
};
---

<Layout title={project.data.title}>
    <div class="max-w-4xl mx-auto px-6 py-12">
        <!-- Back navigation link -->
        <div class="mb-8">
            <a 
                href="/projects" 
                class="inline-flex items-center text-xs font-semibold text-white/60 hover:text-white transition-colors gap-2"
            >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                </svg>
                Volver a proyectos
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
            <!-- Left Info column (1/3 width) -->
            <div class="md:col-span-1 flex flex-col gap-6">
                <!-- Project Image -->
                <div class="relative w-full aspect-video md:aspect-square overflow-hidden bg-white/5 border border-white/10 rounded-2xl">
                    {project.data.image && (
                        <Image
                            image={project.data.image}
                            width={400}
                            height={400}
                            alt={project.data.title}
                            class="object-cover w-full h-full"
                        />
                    )}
                </div>

                <!-- Project Metadata -->
                <div class="bg-white/5 border border-white/10 rounded-2xl p-5 flex flex-col gap-4">
                    <div>
                        <h4 class="text-xs font-semibold uppercase tracking-wider text-white/40 mb-1">Duración</h4>
                        <p class="text-sm font-semibold text-white">
                            {formatDate(project.data.start_date, language)} — {project.data.end_date ? formatDate(project.data.end_date, language) : "Presente"}
                        </p>
                    </div>

                    {project.data.labels && project.data.labels.length > 0 && (
                        <div>
                            <h4 class="text-xs font-semibold uppercase tracking-wider text-white/40 mb-2">Tecnologías</h4>
                            <div class="flex flex-wrap gap-1.5">
                                {project.data.labels.map((tag: any) => (
                                    <span class="text-xs px-2.5 py-0.5 font-medium bg-white/5 text-white/70 border border-white/10 rounded-full">
                                        {tag.label}
                                    </span>
                                ))}
                            </div>
                        </div>
                    )}
                </div>

                <!-- Project URL (External link button) -->
                {project.data.url && (
                    <a
                        href={project.data.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center justify-center w-full px-5 py-3 text-xs font-bold text-black bg-white hover:bg-white/90 border border-white rounded-xl transition-all duration-300 gap-2 shadow-[0_0_15px_rgba(255,255,255,0.05)] hover:shadow-[0_0_20px_rgba(255,255,255,0.1)]"
                    >
                        Visitar sitio web
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                        </svg>
                    </a>
                )}
            </div>

            <!-- Right Details column (2/3 width) -->
            <div class="md:col-span-2 flex flex-col gap-6">
                <div>
                    <Title title={project.data.title} />
                </div>

                <!-- Rich text description -->
                <div class="project-description text-white/80 leading-relaxed text-sm flex flex-col gap-4">
                    <PortableText value={project.data.description} />
                </div>
            </div>
        </div>
    </div>
</Layout>

<style is:global>
    /* Styling elements inside PortableText output */
    .project-description p {
        margin-bottom: 1.25rem;
    }
    .project-description p:last-child {
        margin-bottom: 0;
    }
    .project-description strong {
        color: white;
        font-weight: 600;
    }
    .project-description ul {
        list-style-type: disc;
        padding-left: 1.5rem;
        margin-bottom: 1.25rem;
        display: flex;
        flex-col: gap-1.5;
    }
    .project-description li {
        color: rgba(255, 255, 255, 0.8);
    }
</style>
