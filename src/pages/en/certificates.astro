---
import { getEmDashCollection } from 'emdash'
import Layout from '@layouts/Layout.astro'
import Title from '@/components/Title.astro'
import type { EmDashEntry, CertificateData } from '@/types/emdash'

const language = Astro.currentLocale || 'en'
const { entries: certificateEntries } = await getEmDashCollection(
    'certificates',
    {
        locale: language,
    },
)

const certificates = (certificateEntries ||
    []) as unknown as EmDashEntry<CertificateData>[]

// Helper to assign colors to issuers for beautiful badges
const getIssuerBadgeStyle = (issuerId: string) => {
    switch (issuerId) {
        case 'redhat':
            return 'bg-red-500/20 text-red-300 border-red-500/30'
        case 'cisco':
            return 'bg-sky-500/20 text-sky-300 border-sky-500/30'
        case 'cambridge':
            return 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30'
        case 'anthropic':
            return 'bg-amber-500/20 text-amber-300 border-amber-500/30'
        case 'midudev':
            return 'bg-yellow-500/20 text-yellow-300 border-yellow-500/30'
        case 'eoi7palmas':
            return 'bg-indigo-500/20 text-indigo-300 border-indigo-500/30'
        default:
            return 'bg-white/10 text-white/80 border-white/15'
    }
}

const getIssuerLogo = (issuerId: string) => {
    const validLogos = [
        'midudev',
        'anthropic',
        'eoi7palmas',
        'cambridge',
        'cisco',
        'redhat',
    ]
    if (validLogos.includes(issuerId)) {
        return `/logos/${issuerId}.png`
    }
    return '/logos/empty.png'
}

const getCertificateUrl = (
    fileObj: (typeof certificates)[number]['data']['certificate_file'],
) => {
    if (!fileObj) return ''
    if (typeof fileObj === 'string') return fileObj

    const directUrl = fileObj.src || fileObj.url
    if (directUrl) return directUrl

    const storageKey = fileObj.meta?.storageKey
    if (storageKey) {
        if (Astro.locals.emdash?.getPublicMediaUrl) {
            return Astro.locals.emdash.getPublicMediaUrl(storageKey)
        }
        return `/_emdash/api/media/file/${storageKey}`
    }

    if (fileObj.filename && fileObj.provider === 'local') {
        return `/certificates/${fileObj.filename}`
    }

    if (fileObj.id) {
        return `/_emdash/api/media/file/${fileObj.id}`
    }

    return ''
}

const groupedCertificates = certificates.reduce(
    (acc, cert) => {
        const issuerId = cert.data.issuer_id || 'other'
        if (!acc[issuerId]) {
            acc[issuerId] = {
                id: issuerId,
                name: cert.data.issuer,
                website: cert.data.issuer_website,
                items: [],
            }
        }
        acc[issuerId].items.push(cert)
        return acc
    },
    {} as Record<
        string,
        {
            id: string
            name: string
            website: string
            items: typeof certificates
        }
    >,
)

const groupedList = Object.values(groupedCertificates).sort(
    (a, b) => b.items.length - a.items.length,
)

// Cache for 5 minutes
Astro.response.headers.set('Cache-Control', 'public, max-age=300')
---

<Layout
    title="Certifications"
    description="Professional and academic certifications of Javier Aday Pérez Romero (Cocodrulo). Official courses and certificates from Red Hat, Cisco, Cambridge, and more.">
    <div class="max-w-6xl mx-auto px-6 py-12">
        <header class="mb-12 text-center">
            <Title title="Certifications" />
            <p class="text-white/60 max-w-xl mx-auto text-sm leading-relaxed">
                Here are the certifications and courses I have completed
                throughout my professional and academic career.
            </p>

            {
                certificates.length > 0 && (
                    <div class="flex justify-center items-center gap-2 mt-8">
                        <div class="inline-flex p-1 bg-white/5 backdrop-blur-md border border-white/10 rounded-xl relative">
                            <div
                                id="view-toggle-indicator"
                                class="absolute top-1 bottom-1 left-1 rounded-lg bg-white/10 border border-white/15 transition-all duration-300 pointer-events-none"
                            />

                            <button
                                id="btn-grid-view"
                                class="relative z-10 px-4 py-2 text-xs font-semibold rounded-lg text-white/50 hover:text-white transition-colors cursor-pointer select-none">
                                Show all
                            </button>
                            <button
                                id="btn-grouped-view"
                                class="relative z-10 px-4 py-2 text-xs font-semibold rounded-lg text-white transition-colors cursor-pointer select-none">
                                Group by issuer
                            </button>
                        </div>
                    </div>
                )
            }
        </header>

        {
            certificates.length === 0 ? (
                <div class="text-center py-20 bg-white/5 rounded-2xl border border-white/10">
                    <p class="text-white/40">
                        No certifications found in this language.
                    </p>
                </div>
            ) : (
                <div>
                    {/* Grid View */}
                    <div
                        id="grid-view"
                        class="hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 transition-all duration-300">
                        {certificates.map((cert) => (
                            <div class="group relative flex flex-col justify-between p-6 bg-white/5 hover:bg-white/10 backdrop-blur-md rounded-2xl border border-white/10 hover:border-white/20 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl">
                                <div class="absolute inset-0 bg-linear-to-r rounded-2xl transition-all duration-300 pointer-events-none" />

                                <div>
                                    <div class="flex items-center justify-between mb-4">
                                        <a
                                            href={cert.data.issuer_website}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class={`inline-flex items-center gap-2 text-xs px-2.5 py-1.5 font-semibold rounded-full border ${getIssuerBadgeStyle(cert.data.issuer_id)} hover:brightness-110 transition-all`}>
                                            <img
                                                src={getIssuerLogo(
                                                    cert.data.issuer_id,
                                                )}
                                                alt={cert.data.issuer}
                                                class="w-3.5 h-3.5 object-contain"
                                                loading="lazy"
                                            />
                                            {cert.data.issuer}
                                        </a>
                                    </div>

                                    <h3 class="text-base font-bold text-white leading-snug group-hover:text-blue-300 transition-colors duration-300 mb-6">
                                        {cert.data.title}
                                    </h3>
                                </div>

                                <div class="mt-auto">
                                    <a
                                        href={getCertificateUrl(
                                            cert.data.certificate_file,
                                        )}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="w-full inline-flex items-center justify-center px-4 py-2.5 text-xs font-semibold text-white bg-white/5 hover:bg-white hover:text-black border border-white/10 hover:border-white rounded-xl transition-all duration-300 group-hover:shadow-[0_0_15px_rgba(255,255,255,0.08)]">
                                        View certificate PDF
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke-width="2.5"
                                            stroke="currentColor"
                                            class="w-3.5 h-3.5 ml-1.5 opacity-70 group-hover:translate-x-0.5 transition-transform">
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
                                            />
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        ))}
                    </div>

                    {/* Grouped View */}
                    <div
                        id="grouped-view"
                        class="space-y-10 transition-all duration-300">
                        {groupedList.map((group) => {
                            const hasMany = group.items.length > 3
                            const visibleItems = group.items.slice(0, 3)
                            const hiddenItems = group.items.slice(3)

                            return (
                                <div class="p-8 bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl shadow-xl transition-all duration-300 relative group/issuer overflow-hidden">
                                    <div class="absolute inset-0 bg-linear-to-r rounded-2xl transition-all duration-300 pointer-events-none" />

                                    {/* Issuer Header */}
                                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 pb-6 border-b border-white/10">
                                        <div class="flex items-center gap-4">
                                            <div class="w-16 h-16 p-2 bg-white/5 rounded-2xl border border-white/10 flex items-center justify-center shadow-inner">
                                                <img
                                                    src={getIssuerLogo(
                                                        group.id,
                                                    )}
                                                    alt={group.name}
                                                    class="w-full h-full object-contain filter brightness-105"
                                                    loading="lazy"
                                                />
                                            </div>
                                            <div>
                                                <h2 class="text-xl font-bold text-white flex items-center gap-2.5 flex-wrap">
                                                    {group.name}
                                                    <span class="text-xs px-2.5 py-0.5 font-semibold bg-white/10 text-white/70 border border-white/10 rounded-full">
                                                        {group.items.length}{' '}
                                                        {group.items.length ===
                                                        1
                                                            ? 'certification'
                                                            : 'certifications'}
                                                    </span>
                                                </h2>
                                                <a
                                                    href={group.website}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="text-xs text-blue-400 hover:text-blue-300 hover:underline transition-colors mt-1.5 inline-flex items-center gap-1">
                                                    Visit website
                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        fill="none"
                                                        viewBox="0 0 24 24"
                                                        stroke-width="2.5"
                                                        stroke="currentColor"
                                                        class="w-2.5 h-2.5 opacity-70">
                                                        <path
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                            d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
                                                        />
                                                    </svg>
                                                </a>
                                            </div>
                                        </div>
                                    </div>

                                    {/* Certificates List Grid */}
                                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                                        {visibleItems.map((cert) => (
                                            <div class="group relative flex flex-col justify-between p-5 bg-white/3 hover:bg-white/5 border border-white/5 hover:border-white/10 rounded-xl transition-all duration-300 hover:-translate-y-0.5">
                                                <h3 class="text-sm font-bold text-white/90 leading-snug group-hover:text-blue-300 transition-colors mb-4 line-clamp-3">
                                                    {cert.data.title}
                                                </h3>
                                                <a
                                                    href={getCertificateUrl(
                                                        cert.data
                                                            .certificate_file,
                                                    )}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="w-full mt-auto inline-flex items-center justify-center px-3.5 py-2 text-xs font-semibold text-white bg-white/5 hover:bg-white hover:text-black border border-white/10 hover:border-white rounded-lg transition-all duration-300">
                                                    View PDF
                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        fill="none"
                                                        viewBox="0 0 24 24"
                                                        stroke-width="2.5"
                                                        stroke="currentColor"
                                                        class="w-3.5 h-3.5 ml-1.5 opacity-70">
                                                        <path
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                            d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
                                                        />
                                                    </svg>
                                                </a>
                                            </div>
                                        ))}

                                        {hasMany &&
                                            hiddenItems.map((cert) => (
                                                <div class="hidden-cert hidden group relative flex flex-col justify-between p-5 bg-white/3 hover:bg-white/5 border border-white/5 hover:border-white/10 rounded-xl transition-all duration-300 hover:-translate-y-0.5">
                                                    <h3 class="text-sm font-bold text-white/90 leading-snug group-hover:text-blue-300 transition-colors mb-4 line-clamp-3">
                                                        {cert.data.title}
                                                    </h3>
                                                    <a
                                                        href={getCertificateUrl(
                                                            cert.data
                                                                .certificate_file,
                                                        )}
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                        class="w-full mt-auto inline-flex items-center justify-center px-3.5 py-2 text-xs font-semibold text-white bg-white/5 hover:bg-white hover:text-black border border-white/10 hover:border-white rounded-lg transition-all duration-300">
                                                        View PDF
                                                        <svg
                                                            xmlns="http://www.w3.org/2000/svg"
                                                            fill="none"
                                                            viewBox="0 0 24 24"
                                                            stroke-width="2.5"
                                                            stroke="currentColor"
                                                            class="w-3.5 h-3.5 ml-1.5 opacity-70">
                                                            <path
                                                                stroke-linecap="round"
                                                                stroke-linejoin="round"
                                                                d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
                                                            />
                                                        </svg>
                                                    </a>
                                                </div>
                                            ))}
                                    </div>

                                    {/* Show more button */}
                                    {hasMany && (
                                        <div class="flex justify-center mt-8">
                                            <button
                                                class="btn-toggle-certs px-4 py-2.5 text-xs font-semibold text-white/70 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 rounded-lg transition-all cursor-pointer inline-flex items-center gap-1.5 select-none"
                                                data-expanded="false"
                                                data-count={hiddenItems.length}>
                                                <span>
                                                    Show more (+
                                                    {hiddenItems.length})
                                                </span>
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    fill="none"
                                                    viewBox="0 0 24 24"
                                                    stroke-width="2.5"
                                                    stroke="currentColor"
                                                    class="w-3 h-3 transition-transform duration-300 icon-chevron">
                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        d="m19.5 8.25-7.5 7.5-7.5-7.5"
                                                    />
                                                </svg>
                                            </button>
                                        </div>
                                    )}
                                </div>
                            )
                        })}
                    </div>
                </div>
            )
        }
    </div>
</Layout>

<script is:inline>
    ;(function () {
        const storedView = localStorage.getItem('cert-view-mode') || 'grouped'

        const indicator = document.getElementById('view-toggle-indicator')
        const btnGrid = document.getElementById('btn-grid-view')
        const btnGrouped = document.getElementById('btn-grouped-view')
        const gridView = document.getElementById('grid-view')
        const groupedView = document.getElementById('grouped-view')

        function updateToggleState(view) {
            if (view === 'grouped') {
                gridView?.classList.add('hidden')
                groupedView?.classList.remove('hidden')

                btnGrid?.classList.add('text-white/50')
                btnGrid?.classList.remove('text-white')
                btnGrouped?.classList.remove('text-white/50')
                btnGrouped?.classList.add('text-white')

                if (indicator && btnGrouped) {
                    indicator.style.left = btnGrouped.offsetLeft + 'px'
                    indicator.style.width = btnGrouped.offsetWidth + 'px'
                }
            } else {
                gridView?.classList.remove('hidden')
                groupedView?.classList.add('hidden')

                btnGrid?.classList.remove('text-white/50')
                btnGrid?.classList.add('text-white')
                btnGrouped?.classList.add('text-white/50')
                btnGrouped?.classList.remove('text-white')

                if (indicator && btnGrid) {
                    indicator.style.left = btnGrid.offsetLeft + 'px'
                    indicator.style.width = btnGrid.offsetWidth + 'px'
                }
            }
        }

        // Initialize state
        updateToggleState(storedView)

        // Wait for page to fully render/compute offsets for position
        window.addEventListener('DOMContentLoaded', () => {
            updateToggleState(
                localStorage.getItem('cert-view-mode') || 'grouped',
            )
        })

        // Add listeners
        btnGrid?.addEventListener('click', function () {
            localStorage.setItem('cert-view-mode', 'grid')
            updateToggleState('grid')
        })

        btnGrouped?.addEventListener('click', function () {
            localStorage.setItem('cert-view-mode', 'grouped')
            updateToggleState('grouped')
        })

        window.addEventListener('resize', function () {
            const currentView =
                localStorage.getItem('cert-view-mode') || 'grouped'
            updateToggleState(currentView)
        })

        // Expand/collapse logic for grouped view
        const toggleButtons = document.querySelectorAll('.btn-toggle-certs')
        toggleButtons.forEach(function (btn) {
            btn.addEventListener('click', function () {
                const isExpanded = btn.getAttribute('data-expanded') === 'true'
                const parent = btn.closest('.group\\/issuer')
                const hiddenCerts = parent.querySelectorAll('.hidden-cert')
                const count = btn.getAttribute('data-count')
                const chevron = btn.querySelector('.icon-chevron')

                if (isExpanded) {
                    hiddenCerts.forEach(function (cert) {
                        cert.classList.add('hidden')
                    })
                    btn.setAttribute('data-expanded', 'false')
                    const textSpan = btn.querySelector('span')
                    if (textSpan)
                        textSpan.textContent = 'Show more (+' + count + ')'
                    if (chevron) chevron.style.transform = 'rotate(0deg)'
                } else {
                    hiddenCerts.forEach(function (cert) {
                        cert.classList.remove('hidden')
                    })
                    btn.setAttribute('data-expanded', 'true')
                    const textSpan = btn.querySelector('span')
                    if (textSpan) textSpan.textContent = 'Show less'
                    if (chevron) chevron.style.transform = 'rotate(180deg)'
                }
            })
        })
    })()
</script>
