---
import { getEmDashCollection } from "emdash";
import Layout from "@layouts/Layout.astro";
import Title from "@/components/Title.astro";
import { Image } from "emdash/ui";

const language = Astro.currentLocale || "en";
const { entries: postEntries } = await getEmDashCollection("posts", {
    locale: language,
    orderBy: { published_at: "desc" },
});

const posts = (postEntries || []) as unknown as Array<{
    slug: string;
    data: {
        title: string;
        excerpt: string;
        content: any;
        published_at: string;
        image?: any;
        labels?: Array<{ label: string }>;
    };
}>;

const formatDate = (dateStr: string, locale: string) => {
    if (!dateStr) return "";
    const date = new Date(dateStr);
    const options: Intl.DateTimeFormatOptions = { day: "numeric", month: "long", year: "numeric" };
    return date.toLocaleDateString(locale === "es" ? "es-ES" : "en-US", options);
};
---

<Layout title="Blog" description="Explore Cocodrulo's blog. Articles, guides, and tutorials about software development, programming languages, and technology.">
    <div class="max-w-6xl mx-auto px-6 py-12">
        <header class="mb-12 text-center">
            <Title title="Blog" />
            <p class="text-white/60 max-w-xl mx-auto text-sm leading-relaxed mt-3">
                Thoughts, tutorials, and articles about software development, technology, and learning.
            </p>
        </header>

        {posts.length === 0 ? (
            <div class="text-center py-20 bg-white/5 rounded-2xl border border-white/10">
                <p class="text-white/40">No articles have been published yet.</p>
            </div>
        ) : (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {posts.map((post) => (
                    <article class="group relative flex flex-col justify-between bg-white/5 backdrop-blur-md rounded-2xl border border-white/10 hover:border-white/20 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl overflow-hidden">
                        {/* Background glow on hover */}
                        <div class="absolute inset-0 bg-linear-to-r from-blue-500/0 via-indigo-500/0 to-purple-500/0 group-hover:from-blue-500/5 group-hover:to-purple-500/5 rounded-2xl transition-all duration-300 pointer-events-none"></div>

                        <div>
                            {/* Cover image */}
                            <div class="relative aspect-video w-full overflow-hidden bg-white/5 border-b border-white/10">
                                {post.data.image ? (
                                    <Image
                                        image={post.data.image}
                                        width={600}
                                        height={338}
                                        alt={post.data.title}
                                        class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-500 ease-out"
                                    />
                                ) : (
                                    <div class="w-full h-full flex items-center justify-center bg-linear-to-br from-blue-500/10 to-purple-500/10">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10 text-white/20">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 0 1-2.25 2.25M16.5 7.5V18a2.25 2.25 0 0 0 2.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 0 0 2.25 2.25h13.5M6 7.5h3v3H6v-3Z" />
                                        </svg>
                                    </div>
                                )}
                            </div>

                            <div class="p-6">
                                <div class="mb-3">
                                    <time class="text-xs font-semibold text-white/50" datetime={post.data.published_at}>
                                        {formatDate(post.data.published_at, language)}
                                    </time>
                                </div>

                                <h3 class="text-xl font-bold text-white leading-snug group-hover:text-blue-300 transition-colors duration-300 mb-3">
                                    <a href={`/en/blog/${post.slug}`}>{post.data.title}</a>
                                </h3>

                                <p class="text-white/60 text-sm mb-4 leading-relaxed line-clamp-3">
                                    {post.data.excerpt}
                                </p>

                                {post.data.labels && post.data.labels.length > 0 && (
                                    <div class="flex flex-wrap gap-1.5 mb-2">
                                        {post.data.labels.map((tag) => (
                                            <span class="text-[10px] px-2.5 py-0.5 font-medium bg-white/5 text-white/70 border border-white/10 rounded-full">
                                                {tag.label}
                                            </span>
                                        ))}
                                    </div>
                                )}
                            </div>
                        </div>

                        <div class="px-6 pb-6 pt-0 mt-auto">
                            <a
                                href={`/en/blog/${post.slug}`}
                                class="inline-flex items-center text-xs font-semibold text-white hover:text-blue-300 transition-colors"
                            >
                                Read article
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5 ml-1 opacity-70 group-hover:translate-x-0.5 transition-transform">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                                </svg>
                            </a>
                        </div>
                    </article>
                ))}
            </div>
        )}
    </div>
</Layout>
