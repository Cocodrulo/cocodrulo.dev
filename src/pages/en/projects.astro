---
import { getEmDashCollection } from "emdash";
import Layout from "@layouts/Layout.astro";
import Title from "@/components/Title.astro";
import { Image } from "emdash/ui";

const language = Astro.currentLocale || "en";
const { entries: projectEntries } = await getEmDashCollection("projects", {
    locale: language,
    status: "published",
});

const projects = (projectEntries || []) as unknown as Array<{
    slug: string;
    data: {
        title: string;
        description: any;
        url?: string;
        start_date: string;
        end_date?: string;
        labels: Array<{ label: string }>;
        image: any;
    };
}>;

const formatDate = (dateStr: string, locale: string) => {
    if (!dateStr) return "";
    const date = new Date(dateStr);
    const options: Intl.DateTimeFormatOptions = { month: "short", year: "numeric" };
    const formatted = date.toLocaleDateString(locale === "es" ? "es-ES" : "en-US", options);
    return formatted.charAt(0).toUpperCase() + formatted.slice(1);
};

const getExcerpt = (description: any) => {
    if (!Array.isArray(description)) return "";
    const firstBlock = description[0];
    if (!firstBlock || !Array.isArray(firstBlock.children)) return "";
    const text = firstBlock.children.map((child: any) => child.text).join("");
    return text.length > 120 ? text.slice(0, 120) + "..." : text;
};
---

<Layout title="Projects">
    <div class="max-w-6xl mx-auto px-6 py-12">
        <header class="mb-12 text-center">
            <Title title="Projects" />
            <p class="text-white/60 max-w-xl mx-auto text-sm leading-relaxed">
                A selection of my most prominent works, experiments, and open-source contributions.
            </p>
        </header>

        {projects.length === 0 ? (
            <div class="text-center py-20 bg-white/5 rounded-2xl border border-white/10">
                <p class="text-white/40">No projects found in this language.</p>
            </div>
        ) : (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {projects.map((project) => (
                    <div class="group relative flex flex-col justify-between bg-white/5 backdrop-blur-md rounded-2xl border border-white/10 hover:border-white/20 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl overflow-hidden">
                        <div>
                            <div class="relative aspect-video w-full overflow-hidden bg-white/5 border-b border-white/10">
                                {project.data.image && (
                                    <Image
                                        image={project.data.image}
                                        width={600}
                                        height={338}
                                        alt={project.data.title}
                                        class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-500 ease-out"
                                    />
                                )}
                            </div>

                            <div class="p-6">
                                <div class="flex items-center justify-between gap-2 mb-3">
                                    <span class="text-xs font-semibold text-white/50">
                                        {formatDate(project.data.start_date, language)} — {project.data.end_date ? formatDate(project.data.end_date, language) : "Present"}
                                    </span>
                                </div>

                                <h3 class="text-xl font-bold text-white leading-snug group-hover:text-blue-300 transition-colors duration-300 mb-3">
                                    <a href={`/en/projects/${project.slug}`}>{project.data.title}</a>
                                </h3>

                                <p class="text-white/60 text-sm mb-4 leading-relaxed">
                                    {getExcerpt(project.data.description)}
                                </p>

                                <div class="flex flex-wrap gap-1.5 mb-2">
                                    {project.data.labels?.map((tag) => (
                                        <span class="text-[10px] px-2.5 py-0.5 font-medium bg-white/5 text-white/70 border border-white/10 rounded-full">
                                            {tag.label}
                                        </span>
                                    ))}
                                </div>
                            </div>
                        </div>

                        <div class="px-6 pb-6 pt-0 mt-auto flex items-center justify-between gap-4">
                            <a
                                href={`/en/projects/${project.slug}`}
                                class="inline-flex items-center text-xs font-semibold text-white hover:text-blue-300 transition-colors"
                            >
                                Learn more
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5 ml-1 opacity-70 group-hover:translate-x-0.5 transition-transform">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                                </svg>
                            </a>
                            {project.data.url && (
                                <a
                                    href={project.data.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center justify-center p-2 text-white/70 hover:text-white bg-white/5 hover:bg-white/10 rounded-lg border border-white/10 transition-colors"
                                    title="Visit website"
                                >
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                                    </svg>
                                </a>
                            )}
                        </div>
                    </div>
                ))}
            </div>
        )}
    </div>
</Layout>
