---
import { getEmDashCollection } from 'emdash'
import Layout from '@layouts/Layout.astro'
import Title from '@/components/Title.astro'
import { Image } from 'emdash/ui'
import ProjectCard from '@/components/ProjectCard.astro'

const language = Astro.currentLocale || 'en'
const { entries: projectEntries } = await getEmDashCollection('projects', {
    locale: language,
    status: 'published',
})

const projects = (projectEntries || []) as unknown as Array<{
    slug: string
    data: {
        title: string
        description: any
        url?: string
        start_date: string
        end_date?: string
        labels: Array<{ etiqueta?: string; label?: string }>
        image: any
    }
}>

const formatDate = (dateStr: string, locale: string) => {
    if (!dateStr) return ''
    const date = new Date(dateStr)
    const options: Intl.DateTimeFormatOptions = {
        month: 'short',
        year: 'numeric',
    }
    const formatted = date.toLocaleDateString(
        locale === 'es' ? 'es-ES' : 'en-US',
        options,
    )
    return formatted.charAt(0).toUpperCase() + formatted.slice(1)
}

const getExcerpt = (description: any) => {
    if (!Array.isArray(description)) return ''
    const firstBlock = description[0]
    if (!firstBlock || !Array.isArray(firstBlock.children)) return ''
    const text = firstBlock.children.map((child: any) => child.text).join('')
    return text.length > 120 ? text.slice(0, 120) + '...' : text
}
---

<Layout
    title="Projects"
    description="Discover my project portfolio. A collection of web applications, software tools, and open-source contributions.">
    <div class="max-w-6xl mx-auto px-6 py-12">
        <header class="mb-12 text-center">
            <Title title="Projects" />
            <p class="text-white/60 max-w-xl mx-auto text-sm leading-relaxed">
                A selection of my most prominent works, experiments, and
                open-source contributions.
            </p>
        </header>

        {
            projects.length === 0 ? (
                <div class="text-center py-20 bg-white/5 rounded-2xl border border-white/10">
                    <p class="text-white/40">
                        No projects found in this language.
                    </p>
                </div>
            ) : (
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {projects.map((project) => (
                        <ProjectCard
                            image={project.data.image}
                            title={project.data.title}
                            start_date={project.data.start_date}
                            end_date={project.data.end_date}
                            labels={project.data.labels}
                            description={project.data.description}
                            slug={project.slug}
                            url={project.data.url}
                        />
                    ))}
                </div>
            )
        }
    </div>
</Layout>
