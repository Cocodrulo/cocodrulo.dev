---
import Layout from '@layouts/Layout.astro'
import Hero from '@components/Hero.astro'
import About from '@components/About.astro'
import Timeline from '@components/Timeline.astro'
import FeaturedAndLatest from '@components/FeaturedAndLatest.astro'

// Cache for 5 minutes
Astro.response.headers.set('Cache-Control', 'public, max-age=300')
---

<Layout
    title="Home"
    description="Official website of Javier Aday Pérez Romero (Cocodrulo) - Software developer and creator. Explore my projects, blog posts, and certifications.">
    <Hero />
    <About />
    <Timeline />
    <FeaturedAndLatest />
</Layout>
