---
import { getEmDashCollection } from 'emdash'
import Layout from '@layouts/Layout.astro'
import Title from '@/components/Title.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import type { EmDashEntry, ProjectData } from '@/types/emdash'

const language = Astro.currentLocale || 'es'
const { entries: projectEntries } = await getEmDashCollection('projects', {
    locale: language,
    status: 'published',
})

const projects = (projectEntries || []) as unknown as EmDashEntry<ProjectData>[]

// Cache for 5 minutes
Astro.response.headers.set('Cache-Control', 'public, max-age=300')
---

<Layout
    title="Proyectos"
    description="Descubre mi portafolio de proyectos. Una colección de aplicaciones web, utilidades de software y contribuciones de código abierto.">
    <div class="max-w-6xl mx-auto px-6 py-12">
        <header class="mb-12 text-center">
            <Title title="Proyectos" />
            <p class="text-white/60 max-w-xl mx-auto text-sm leading-relaxed">
                Una selección de mis trabajos más destacados, experimentos y
                contribuciones de código abierto.
            </p>
        </header>

        {
            projects.length === 0 ? (
                <div class="text-center py-20 bg-white/5 rounded-2xl border border-white/10">
                    <p class="text-white/40">
                        No se encontraron proyectos en este idioma.
                    </p>
                </div>
            ) : (
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {projects.map((project) => (
                        <ProjectCard
                            image={project.data.image}
                            title={project.data.title}
                            start_date={project.data.start_date}
                            end_date={project.data.end_date}
                            labels={project.data.labels}
                            description={project.data.description}
                            slug={project.slug}
                            url={project.data.url}
                        />
                    ))}
                </div>
            )
        }
    </div>
</Layout>
