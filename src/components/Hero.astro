---
import { getEmDashEntry, getEmDashCollection } from 'emdash'
import IconsHandler from '@/assets/icons/IconsHandler'

const language = Astro.currentLocale || 'es'

const { entry: profileEntry } = await getEmDashEntry('profile', 'profile', {
    locale: language,
})
const profile = (profileEntry?.data || { name: '', label: '' }) as {
    name: string
    label: string
}

const { entries: socialEntries } = await getEmDashCollection('socials', {
    locale: language,
})
const socials = (socialEntries || []) as unknown as Array<{
    data: { name: string; url: string; label: string }
}>
---

<section id="hero" class="relative h-[70dvh] px-20">
    <div
        class="px-6 max-w-2xl h-full flex flex-col items-start justify-center text-start">
        <h1 class="text-5xl mb-3 text-white">{profile.name}</h1>
        <p class="text-white/70 text-balance">
            {profile.label}
        </p>
        <div class="flex items-center gap-6 mt-8 flex-wrap">
            <a
                href={`/cv.pdf${language === 'en' ? '?lang=en' : ''}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-blue-600/20 hover:bg-blue-600/30 border border-blue-500/30 hover:border-blue-500/50 text-white font-medium text-sm transition-all duration-300 shadow-lg shadow-blue-950/20 group backdrop-blur-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-400 group-hover:translate-y-0.5 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <polyline points="7 10 12 15 17 10"/>
                    <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                <span>{language === 'es' ? 'Descargar CV' : 'Download CV'}</span>
            </a>
            <div class="flex gap-6 items-center">
                {
                    socials.map((social) => {
                        const key =
                            social.data.name.charAt(0).toUpperCase() +
                            social.data.name.slice(1)
                        const Icon = IconsHandler[key as keyof typeof IconsHandler]
                        return (
                            <a href={social.data.url}>
                                {Icon && (
                                    <Icon class="w-6 h-6 text-white/70 hover:text-white transition-colors duration-300" />
                                )}
                            </a>
                        )
                    })
                }
            </div>
        </div>
    </div>
    <div
        class="absolute right-20 h-full opacity-50 md:opacity-100 mask-b-from-0% top-0 mask-b-to-120% mask-t-from-70% object-cover">
        <img
            src="/images/me.png"
            alt="Javier Aday Pérez Romero"
            class="object-cover w-full h-full"
        />
    </div>
</section>
