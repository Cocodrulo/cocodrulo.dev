---
import type { GHPullRequest } from '@/types/Github'

interface Props {
    prs: GHPullRequest[]
    totalCount: number
    lang?: 'es' | 'en'
}

const { prs, totalCount, lang = 'es' } = Astro.props

const locale = lang === 'es' ? 'es-ES' : 'en-US'

const i18n = {
    es: {
        empty: 'No se encontraron pull requests.',
        openedOn: 'Abierto el',
        updated: 'Actualizado',
        viewAll: 'Ver todos los PRs en GitHub →',
        comments: (n: number) => `${n} comentario${n !== 1 ? 's' : ''}`,
    },
    en: {
        empty: 'No pull requests found.',
        openedOn: 'Opened on',
        updated: 'Updated',
        viewAll: 'View all PRs on GitHub →',
        comments: (n: number) => `${n} comment${n !== 1 ? 's' : ''}`,
    },
} as const

const t = i18n[lang]

const fmtDate = (s: string) =>
    new Date(s).toLocaleDateString(locale, {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
    })
---

<div class="gh-pr-wrapper">
    {
        prs.length === 0 ? (
            <p class="gh-empty">{t.empty}</p>
        ) : (
            <ul class="gh-pr-list">
                {prs.map((pr) => (
                    <li class="gh-pr-item">
                        <!-- State icon — GraphQL gives OPEN | CLOSED | MERGED directly -->
                        <div class="gh-pr-icon" aria-label={pr.state.toLowerCase()}>
                            {pr.state === 'MERGED' && (
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="#a371f7" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <path d="M5.45 5.154A4.25 4.25 0 0 0 9.25 7.5h1.378a2.251 2.251 0 1 1 0 1.5H9.25A5.734 5.734 0 0 1 5 7.123v3.505a2.25 2.25 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.95-.218ZM4.25 13.5a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm8.5-4.5a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5ZM5 3.25a.75.75 0 1 0 0 .005V3.25Z" />
                                </svg>
                            )}
                            {pr.state === 'OPEN' && (
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="#3fb950" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <path d="M1.5 3.25a2.25 2.25 0 1 1 3 2.122v5.256a2.251 2.251 0 1 1-1.5 0V5.372A2.25 2.25 0 0 1 1.5 3.25Zm5.677-.177L9.573.677A.25.25 0 0 1 10 .854V2.5h1A2.5 2.5 0 0 1 13.5 5v5.628a2.251 2.251 0 1 1-1.5 0V5a1 1 0 0 0-1-1h-1v1.646a.25.25 0 0 1-.427.177L7.177 3.427a.25.25 0 0 1 0-.354ZM3.75 2.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm0 9.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm8.25.75a.75.75 0 1 0 1.5 0 .75.75 0 0 0-1.5 0Z" />
                                </svg>
                            )}
                            {pr.state === 'CLOSED' && (
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="#f85149" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <path d="M3.25 1A2.25 2.25 0 0 1 4 5.372v5.256a2.251 2.251 0 1 1-1.5 0V5.372A2.251 2.251 0 0 1 3.25 1Zm9.5 5.5a.75.75 0 0 1 .75.75v3.378a2.251 2.251 0 1 1-1.5 0V7.25a.75.75 0 0 1 .75-.75Zm-2.03-5.273a.75.75 0 0 1 1.06 0l.97.97.97-.97a.748.748 0 0 1 1.265.332.75.75 0 0 1-.205.729l-.97.97.97.97a.751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018l-.97-.97-.97.97a.749.749 0 0 1-1.275-.326.749.749 0 0 1 .215-.734l.97-.97-.97-.97a.75.75 0 0 1 0-1.06ZM2.5 3.25a.75.75 0 1 0 1.5 0 .75.75 0 0 0-1.5 0ZM3.25 12a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm9.5 0a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Z" />
                                </svg>
                            )}
                        </div>

                        <!-- Content -->
                        <div class="gh-pr-content">
                            <span class="gh-pr-repo">
                                {pr.repository.nameWithOwner}#{pr.number}
                            </span>
                            <h3 class="gh-pr-title">
                                <a
                                    href={pr.url}
                                    target="_blank"
                                    rel="noopener"
                                    class="gh-pr-link"
                                >
                                    {pr.title}
                                </a>
                            </h3>
                            <p class="gh-pr-dates">
                                {t.openedOn} {fmtDate(pr.createdAt)}
                                &nbsp;·&nbsp; {t.updated} {fmtDate(pr.updatedAt)}
                            </p>

                            {pr.labels.nodes.length > 0 && (
                                <div class="gh-pr-labels">
                                    {pr.labels.nodes.map((label) => (
                                        <span
                                            class="gh-label"
                                            style={`background:#${label.color}22;color:#${label.color};border-color:#${label.color}55`}
                                        >
                                            {label.name}
                                        </span>
                                    ))}
                                </div>
                            )}
                        </div>

                        <!-- Comment count -->
                        {pr.comments.totalCount > 0 && (
                            <a
                                href={pr.url}
                                target="_blank"
                                rel="noopener"
                                class="gh-pr-comments"
                                aria-label={t.comments(pr.comments.totalCount)}
                            >
                                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <path d="M1 2.75C1 1.784 1.784 1 2.75 1h10.5c.966 0 1.75.784 1.75 1.75v7.5A1.75 1.75 0 0 1 13.25 12H9.06l-2.573 2.573A1.458 1.458 0 0 1 4 13.543V12H2.75A1.75 1.75 0 0 1 1 10.25Zm1.75-.25a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h2a.75.75 0 0 1 .75.75v2.19l2.72-2.72a.749.749 0 0 1 .53-.22h4.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Z" />
                                </svg>
                                {pr.comments.totalCount}
                            </a>
                        )}
                    </li>
                ))}
            </ul>
        )
    }

    <div class="gh-list-footer">
        <a
            href="https://github.com/pulls?q=author%3ACocodrulo"
            target="_blank"
            rel="noopener"
            class="gh-footer-link"
        >
            {t.viewAll}
        </a>
    </div>
</div>

<style>
    .gh-pr-wrapper {
        border: 1px solid #30363d;
        border-radius: 6px;
        overflow: hidden;
        background: #0d1117;
    }
    .gh-empty {
        padding: 2rem 1.25rem;
        color: #8b949e;
        text-align: center;
        margin: 0;
    }
    .gh-pr-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }
    .gh-pr-item {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 0.875rem 1rem;
        border-top: 1px solid #21262d;
        transition: background 0.15s;
    }
    .gh-pr-item:first-child {
        border-top: none;
    }
    .gh-pr-item:hover {
        background: #161b22;
    }
    .gh-pr-icon {
        flex-shrink: 0;
        margin-top: 2px;
    }
    .gh-pr-content {
        flex: 1;
        min-width: 0;
    }
    .gh-pr-repo {
        font-size: 11px;
        color: #8b949e;
        display: block;
        margin-bottom: 2px;
    }
    .gh-pr-title {
        font-size: 13px;
        font-weight: 600;
        margin: 0 0 3px;
        line-height: 1.4;
    }
    .gh-pr-link {
        color: #e6edf3;
        text-decoration: none;
    }
    .gh-pr-link:hover {
        color: #58a6ff;
    }
    .gh-pr-dates {
        font-size: 11px;
        color: #8b949e;
        margin: 0;
    }
    .gh-pr-labels {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin-top: 5px;
    }
    .gh-label {
        font-size: 10px;
        font-weight: 500;
        padding: 1px 7px;
        border-radius: 20px;
        border: 1px solid;
        white-space: nowrap;
    }
    .gh-pr-comments {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 12px;
        color: #8b949e;
        text-decoration: none;
        flex-shrink: 0;
        margin-top: 2px;
        transition: color 0.15s;
    }
    .gh-pr-comments:hover {
        color: #58a6ff;
    }
    .gh-list-footer {
        padding: 0.625rem 1rem;
        border-top: 1px solid #30363d;
        background: #161b22;
    }
    .gh-footer-link {
        color: #58a6ff;
        font-size: 12px;
        text-decoration: none;
    }
    .gh-footer-link:hover {
        text-decoration: underline;
    }
</style>
