---
import { Image } from 'emdash/ui'
import type { Label, ImageField } from '@/types/emdash'

const language = Astro.currentLocale || 'es'

const formatDate = (dateStr: string, locale: string) => {
    if (!dateStr) return ''
    const date = new Date(dateStr)
    const options: Intl.DateTimeFormatOptions = {
        month: 'short',
        year: 'numeric',
    }
    const formatted = date.toLocaleDateString(
        locale === 'es' ? 'es-ES' : 'en-US',
        options,
    )
    return formatted.charAt(0).toUpperCase() + formatted.slice(1)
}

const getExcerpt = (description: any) => {
    if (!Array.isArray(description)) return ''
    const firstBlock = description[0]
    if (!firstBlock || !Array.isArray(firstBlock.children)) return ''
    const text = firstBlock.children.map((child: any) => child.text).join('')
    return text.length > 120 ? text.slice(0, 120) + '...' : text
}

export interface Props {
    image?: ImageField
    title: string
    start_date?: string
    end_date?: string
    labels?: Label[]
    description: any
    slug: string
    url?: string
}

const translations = {
    learn_more: {
        es: 'Más información',
        en: 'Learn more',
    },
    visit_website: {
        es: 'Visitar sitio web',
        en: 'Visit website',
    },
    date: {
        es: 'Presente',
        en: 'Today',
    },
}

const { image, title, start_date, end_date, labels, description, slug, url } =
    Astro.props as Props
---

<div
    class="group relative flex flex-col justify-between bg-neutral-900/40 backdrop-blur-md rounded-2xl border border-white/10 hover:border-blue-500/30 transition-all duration-300 hover:-translate-y-1 overflow-hidden">
    <div>
        <div
            class="relative aspect-video w-full overflow-hidden bg-white/5 border-b border-white/10">
            {
                image && (
                    <Image
                        image={image}
                        width={600}
                        height={338}
                        alt={title}
                        class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-500 ease-out"
                    />
                )
            }
        </div>

        <div class="p-6 relative z-10">
            {start_date && (
                <div class="flex items-center justify-between gap-2 mb-3">
                    <span class="text-xs font-semibold text-white/50">
                        {formatDate(start_date, language)} — {
                            end_date
                                ? formatDate(end_date, language)
                                : translations.date[
                                      language as keyof typeof translations.date
                                  ]
                        }
                    </span>
                </div>
            )}

            <h3
                class="text-xl font-bold text-white leading-snug group-hover:text-blue-300 transition-colors duration-300 mb-3">
                <a href={`/projects/${slug}`}>{title}</a>
            </h3>

            <p class="text-white/60 text-sm mb-4 leading-relaxed">
                {getExcerpt(description)}
            </p>

            <div class="flex flex-wrap gap-1.5 mb-2">
                {
                    labels?.map((tag) => (
                        <span class="text-[10px] font-bold tracking-wider uppercase px-2.5 py-1 bg-blue-500/10 text-blue-300 border border-blue-500/20 rounded-md hover:bg-blue-500/20 transition-all">
                            {tag.etiqueta || tag.label}
                        </span>
                    ))
                }
            </div>
        </div>
    </div>

    <div
        class="px-6 pb-6 pt-0 mt-auto flex items-center justify-between gap-4 relative z-10">
        <a
            href={`/projects/${slug}`}
            class="inline-flex items-center text-xs font-semibold text-white hover:text-blue-300 transition-colors">
            {
                translations.learn_more[
                    language as keyof typeof translations.learn_more
                ]
            }
            <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2.5"
                stroke="currentColor"
                class="w-3.5 h-3.5 ml-1 opacity-70 group-hover:translate-x-0.5 transition-transform">
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
            </svg>
        </a>
        {
            url && (
                <a
                    href={url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center p-2 text-white/70 hover:text-white bg-white/5 hover:bg-white/10 rounded-lg border border-white/10 transition-colors"
                    title={
                        translations.visit_website[
                            language as keyof typeof translations.visit_website
                        ]
                    }>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="2.5"
                        stroke="currentColor"
                        class="w-4 h-4">
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
                        />
                    </svg>
                </a>
            )
        }
    </div>
</div>
