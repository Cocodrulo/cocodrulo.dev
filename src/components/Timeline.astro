---
import { getEmDashCollection } from 'emdash'
import type { EmDashEntry, TimelineData } from '@/types/emdash'

const language = Astro.currentLocale || 'es'

const { entries: timelineEntries } = (await getEmDashCollection('timeline', {
    locale: language,
    status: 'published',
})) as unknown as { entries: EmDashEntry<TimelineData>[] }

// Order by start_year descending (most recent first)
const timeline = (timelineEntries || []).sort(
    (a, b) =>
        parseInt(b.data.start_year) - parseInt(a.data.start_year),
)

const t = {
    es: {
        sectionTitle: 'Trayectoria',
        sectionSubtitle: 'Mi historial de estudios y experiencia profesional.',
        present: 'Presente',
        work: 'Trabajo',
        education: 'Estudios',
        empty: 'No hay entradas publicadas aún.',
    },
    en: {
        sectionTitle: 'Career',
        sectionSubtitle: 'My academic background and professional experience.',
        present: 'Present',
        work: 'Work',
        education: 'Education',
        empty: 'No published entries yet.',
    },
}[language as 'es' | 'en'] || {
    sectionTitle: 'Trayectoria',
    sectionSubtitle: 'Mi historial de estudios y experiencia profesional.',
    present: 'Presente',
    work: 'Trabajo',
    education: 'Estudios',
    empty: 'No hay entradas publicadas aún.',
}
---

<section id="timeline" class="timeline-section scroll">
    <div class="timeline-inner">
        <header class="timeline-header">
            <h2 class="timeline-title">{t.sectionTitle}</h2>
            <p class="timeline-subtitle">{t.sectionSubtitle}</p>
        </header>

        {
            timeline.length === 0 ? (
                <div class="timeline-empty">
                    <p>{t.empty}</p>
                </div>
            ) : (
                <div class="timeline-track">
                    <div class="timeline-line" aria-hidden="true" />

                    {timeline.map((item, index) => (
                        <div
                            class={`timeline-item ${index % 2 === 0 ? 'timeline-item--left' : 'timeline-item--right'}`}
                        >
                            <div class="timeline-dot-wrapper">
                                <div
                                    class={`timeline-dot timeline-dot--${item.data.type} ${item.data.current ? 'timeline-dot--current' : ''}`}
                                >
                                    {item.data.type === 'work' ? (
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke-width="2"
                                            stroke="currentColor"
                                            class="timeline-dot-icon"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0"
                                            />
                                        </svg>
                                    ) : (
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke-width="2"
                                            stroke="currentColor"
                                            class="timeline-dot-icon"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.627 48.627 0 0 1 12 20.904a48.627 48.627 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.57 50.57 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5"
                                            />
                                        </svg>
                                    )}
                                </div>
                            </div>

                            <div class="timeline-card">
                                <div class="timeline-card-top">
                                    <span
                                        class={`timeline-badge timeline-badge--${item.data.type}`}
                                    >
                                        {item.data.type === 'work'
                                            ? t.work
                                            : t.education}
                                    </span>
                                    <span class="timeline-years">
                                        {item.data.current
                                            ? `${item.data.start_year} — ${t.present}`
                                            : item.data.end_year
                                              ? `${item.data.start_year} — ${item.data.end_year}`
                                              : item.data.start_year}
                                    </span>
                                </div>
                                <h3 class="timeline-card-title">
                                    {item.data.title}
                                </h3>
                                <p class="timeline-card-place">
                                    {item.data.place}
                                </p>
                                {item.data.description && (
                                    <p class="timeline-card-desc">
                                        {item.data.description}
                                    </p>
                                )}
                                {item.data.current && (
                                    <span class="timeline-current-badge">
                                        <span class="timeline-current-dot" />
                                        {language === 'es'
                                            ? 'Actualmente'
                                            : 'Currently'}
                                    </span>
                                )}
                            </div>
                        </div>
                    ))}
                </div>
            )
        }
    </div>
</section>


<style>
    .timeline-section {
        padding: 5rem 5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    .timeline-inner {
        max-width: 56rem;
        margin: 0 auto;
    }

    .timeline-empty {
        text-align: center;
        padding: 3rem 1.5rem;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: 0.875rem;
        color: rgba(255, 255, 255, 0.3);
        font-size: 0.875rem;
    }

    .timeline-header {
        text-align: center;
        margin-bottom: 4rem;
    }

    .timeline-title {
        font-size: 2.25rem;
        font-weight: 800;
        color: white;
        letter-spacing: -0.02em;
        margin-bottom: 0.75rem;
    }

    .timeline-subtitle {
        color: rgba(255, 255, 255, 0.5);
        font-size: 0.9rem;
        line-height: 1.6;
    }

    /* Track */
    .timeline-track {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    .timeline-line {
        position: absolute;
        left: 50%;
        top: 0;
        bottom: 0;
        width: 1px;
        background: rgba(255, 255, 255, 0.08);
        transform: translateX(-50%);
    }

    /* Item */
    .timeline-item {
        display: grid;
        grid-template-columns: 1fr 3rem 1fr;
        gap: 0;
        align-items: start;
    }

    .timeline-item--left .timeline-card {
        grid-column: 1;
        grid-row: 1;
        text-align: right;
        padding-right: 2rem;
    }

    .timeline-item--left .timeline-dot-wrapper {
        grid-column: 2;
        grid-row: 1;
    }

    .timeline-item--left .timeline-card-top {
        justify-content: flex-end;
    }

    .timeline-item--right .timeline-card {
        grid-column: 3;
        grid-row: 1;
        text-align: left;
        padding-left: 2rem;
    }

    .timeline-item--right .timeline-dot-wrapper {
        grid-column: 2;
        grid-row: 1;
    }

    /* Dot */
    .timeline-dot-wrapper {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding-top: 0.25rem;
        z-index: 1;
    }

    .timeline-dot {
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 50%;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: #1a1918;
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgba(255, 255, 255, 0.5);
        transition: border-color 0.25s, color 0.25s;
        flex-shrink: 0;
    }

    .timeline-dot--work {
        border-color: rgba(255, 255, 255, 0.15);
        color: rgba(255, 255, 255, 0.6);
    }

    .timeline-dot--education {
        border-color: rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.4);
    }

    .timeline-dot--current {
        border-color: rgba(255, 255, 255, 0.35);
        color: white;
    }

    .timeline-dot-icon {
        width: 1rem;
        height: 1rem;
    }

    /* Card */
    .timeline-card {
        padding: 1.25rem 1.5rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: 0.875rem;
        transition:
            border-color 0.2s,
            background 0.2s;
    }

    .timeline-card:hover {
        border-color: rgba(255, 255, 255, 0.14);
        background: rgba(255, 255, 255, 0.05);
    }

    .timeline-card-top {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        margin-bottom: 0.625rem;
        flex-wrap: wrap;
    }

    .timeline-badge {
        font-size: 0.65rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 0.2rem 0.55rem;
        border-radius: 9999px;
        border: 1px solid;
    }

    .timeline-badge--work {
        color: rgba(255, 255, 255, 0.75);
        border-color: rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.05);
    }

    .timeline-badge--education {
        color: rgba(200, 200, 255, 0.75);
        border-color: rgba(180, 180, 255, 0.2);
        background: rgba(180, 180, 255, 0.05);
    }

    .timeline-years {
        font-size: 0.72rem;
        color: rgba(255, 255, 255, 0.35);
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.02em;
    }

    .timeline-card-title {
        font-size: 1rem;
        font-weight: 700;
        color: rgba(255, 255, 255, 0.9);
        line-height: 1.3;
        margin-bottom: 0.2rem;
    }

    .timeline-card-place {
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.4);
        margin-bottom: 0.625rem;
        font-style: italic;
    }

    .timeline-card-desc {
        font-size: 0.82rem;
        color: rgba(255, 255, 255, 0.5);
        line-height: 1.6;
    }

    /* "Currently" badge */
    .timeline-current-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.68rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.55);
        margin-top: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .timeline-current-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.7);
        animation: pulse-dot 2s ease-in-out infinite;
        flex-shrink: 0;
    }

    @keyframes pulse-dot {
        0%,
        100% {
            opacity: 1;
            transform: scale(1);
        }
        50% {
            opacity: 0.4;
            transform: scale(0.7);
        }
    }

    /* Responsive */
    @media (max-width: 640px) {
        .timeline-section {
            padding: 3rem 1.25rem;
        }

        .timeline-line {
            left: 1.125rem;
        }

        .timeline-item {
            grid-template-columns: 2.25rem 1fr;
            gap: 0;
        }

        .timeline-item--left .timeline-card,
        .timeline-item--right .timeline-card {
            grid-column: 2;
            grid-row: 1;
            text-align: left;
            padding-left: 1rem;
            padding-right: 0;
        }

        .timeline-item--left .timeline-dot-wrapper,
        .timeline-item--right .timeline-dot-wrapper {
            grid-column: 1;
            grid-row: 1;
        }

        .timeline-item--left .timeline-card-top {
            justify-content: flex-start;
        }
    }
</style>
