---
export interface Props {
    title: string;
    as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}

const { title, as: Tag = "h1" } = Astro.props;
---

<Tag
    class="text-4xl font-extrabold text-transparent bg-clip-text bg-linear-to-r from-gray-200 via-gray-400 to-white inline-block mb-3">
    {title}
</Tag>
