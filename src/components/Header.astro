---
import { getMenu } from "emdash";
const language = Astro.currentLocale || "es";
const primaryMenu = await getMenu("primary", { locale: language });
const menuItems = primaryMenu?.items || [];
---

<header class="flex justify-between items-center px-7 py-4">
    <a href="/">
        <img
            src="/images/Logo.svg"
            class="h-12 opacity-85 hover:opacity-100 transition-opacity duration-300"
            alt="Logo"
        />
    </a>

    <nav>
        <ul class="flex items-center gap-10">
            {
                menuItems.map((item) => (
                    <li class="text-white/70 hover:text-white transition-colors duration-300">
                        <a href={item.url}>
                            {item.label}
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>
</header>
