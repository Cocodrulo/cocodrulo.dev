---
import { getEmDashEntry } from 'emdash'
const language = Astro.currentLocale || 'es'
const { entry: aboutEntry } = await getEmDashEntry('about', 'about', {
    locale: language,
})
const about = (aboutEntry?.data || {
    label: '',
    subtitle: '',
    paragraphs: [],
}) as { label: string; subtitle: string; paragraphs: string[] }
const paragraphs = about.paragraphs
---

<section
    class="px-20 w-full bg-gray-900/40 grid grid-cols-1 md:grid-cols-2 gap-10 p-8"
    id="about">
    <div class="col-span-1">
        <h2 class="text-3xl mb-3 text-white">
            {about.label}
        </h2>
        <p class="text-white/60 text-balance">
            {about.subtitle}
        </p>
    </div>
    <div class="col-span-1 flex flex-col gap-4">
        {
            paragraphs.map((paragraph) => (
                <p class="text-white/70 text-pretty">{paragraph}</p>
            ))
        }
    </div>
</section>
