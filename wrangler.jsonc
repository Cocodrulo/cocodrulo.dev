{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cocodrulo-dev",
	"compatibility_date": "2026-06-27",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cocodrulo-dev",
			"database_id": "5e478008-6188-4169-b5fc-94af65f3dee2",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "cocodrulo-dev",
		},
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "0a6a50c9f17b42acafc393440cada60d",
		},
		{
			"id": "a86de4a7c0da4a6992faae71239bcaa7",
			"binding": "SESSION"
		},
	],
	"routes": [
		{
			"pattern": "cocodrulo.dev",
			"zone_name": "cocodrulo.dev",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 1
		}
	}
}